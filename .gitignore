# ─────────────────────────────────────────────
# MODELS — the big offenders (5+ GB each)
# ─────────────────────────────────────────────
models/
*.bin
*.gguf
*.safetensors
*.mlx
*.npz
*.ckpt
*.pth
*.onnx
*.msgpack
whisper-*-mlx/
whisper-*-merged/
Qwen*/
mlx-community/
mlx_model/

# ─────────────────────────────────────────────
# MEDIA INPUT — your source recordings
# ─────────────────────────────────────────────
input/
!input/.gitkeep

# ─────────────────────────────────────────────
# AUDIO / VIDEO ASSETS — bg music, nasheed
# These are copyrighted or large
# ─────────────────────────────────────────────
assets/bg_music/*
assets/nasheed/*
assets/fonts/*
!assets/bg_music/.gitkeep
!assets/nasheed/.gitkeep
!assets/fonts/.gitkeep

# But KEEP small example files that ship with the repo
!assets/**/*.README.md
!assets/**/*.example

# ─────────────────────────────────────────────
# OUTPUT — all generated content
# ─────────────────────────────────────────────
output/
!output/.gitkeep

# ─────────────────────────────────────────────
# WORKSPACE — temp files
# ─────────────────────────────────────────────
workspace/
!workspace/.gitkeep

# ─────────────────────────────────────────────
# ARTIFACTS — fbu traces
# ─────────────────────────────────────────────
artifacts/
*.trace
*_trace.json
*.har

# ─────────────────────────────────────────────
# CACHES — model downloads
# ─────────────────────────────────────────────
.cache/
.huggingface/
# If you ever set HF_HOME inside the project:
hf_cache/
hf_models/

# ─────────────────────────────────────────────
# PYTHON
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/
.python-version

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

